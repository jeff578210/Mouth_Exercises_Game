# 複製此檔成 .env 並填入實際連線資訊
# 切勿把 .env 提交進 git(.gitignore 已排除)

# === SQL Server 連線 ===
DB_SERVER=localhost           # IP 或 hostname,例如 192.168.1.100 或 your-server.database.windows.net
DB_PORT=1433
DB_NAME=MouthExercisesDb
DB_USER=sa
DB_PASSWORD=YourStrongPassword!

# Azure SQL Database 必須 true;本機開發 SQL Server 通常 false
DB_ENCRYPT=true
# 自簽憑證的本機 SQL Server 才設 true,Azure SQL 一律 false
DB_TRUST_CERT=false

# === API server ===
PORT=3000

# 允許的前端來源(逗號分隔多個);* = 全部允許(開發用);上線改成 https://your-game.com
ALLOWED_ORIGINS=*
