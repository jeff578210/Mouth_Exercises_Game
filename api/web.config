<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure App Service (Windows) 必備:讓 IIS 透過 iisnode 把所有請求轉給 server.js。
  Linux 上不會用到這檔(也不影響)。
-->
<configuration>
  <system.webServer>

    <!-- 註冊 iisnode handler -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- 把所有路徑改寫到 server.js,讓 Express 處理路由 -->
    <rewrite>
      <rules>
        <!-- 靜態檔(若有)直接服務,不丟給 node -->
        <rule name="StaticContent">
          <action type="Rewrite" url="public{REQUEST_URI}" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <match url="^.*\.(jpg|jpeg|png|gif|svg|css|js|html|ico)$" />
        </rule>
        <!-- 其餘全部交給 server.js -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- 安全性:不要暴露 server.js 原始碼 -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- iisnode 設定 -->
    <iisnode
      nodeProcessCommandLine="node"
      loggingEnabled="true"
      devErrorsEnabled="false"
      watchedFiles="*.js;web.config" />

  </system.webServer>
</configuration>
